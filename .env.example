# Web3Forms access key pro kontaktní formulář.
# Nepovinné — v lib/site.ts je výchozí klíč navázaný na info@peakflow.cz.
# Nastavte jen když chcete klíč vyměnit bez zásahu do kódu
# (Workers & Pages → peakflow-web → Settings → Variables and Secrets).
NEXT_PUBLIC_WEB3FORMS_KEY=

# Google Tag Manager — ID kontejneru.
# Nepovinné — výchozí hodnota GTM-T4RFMPPX je v lib/site.ts.
# Nastavte na prázdnou hodnotu, pokud chcete měření vypnout.
# V `npm run dev` se GTM nenačítá nikdy.
NEXT_PUBLIC_GTM_ID=
